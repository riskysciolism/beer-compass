# Template for the runtime configuration - copy this to `.env`.
# Contains no secrets; it is only evaluated at *build* time (VITE_*).

# --- Option A: with the local backend (npm run dev) ---------------------------
# The backend runs on :8787 and the Vite dev server proxies /api to it.
VITE_API_BASE=/api
VITE_VERSION_URL=/api/version.json
VITE_DATA_URL=/api/data.json

# Dummy echo endpoint (identifiable request, no personal data).
VITE_ECHO_URL=/api/echo

# --- Option B: purely static hosting (no backend) ------------------------------
# The data then lives next to the app as files, e.g. /data/data.json.
# VITE_API_BASE=
# VITE_VERSION_URL=/data/version.json
# VITE_DATA_URL=/data/data.json
# VITE_ECHO_URL=
